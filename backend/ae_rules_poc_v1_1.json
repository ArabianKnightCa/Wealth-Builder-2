{
  "schema_version": "1.1.1",
  "rules_version": "POC-v1.1.1",
  "selection": {
    "total_items": 20,
    "bucket_weights": {
      "base": 8,
      "motivation": 4,
      "habits": 4,
      "risk_confidence": 4
    },
    "determinism": {
      "seed": "user_id",
      "tie_breaker": "lexicographic_by_id"
    }
  },
  "constraints": {
    "age_bands": {
      "8-12": {
        "exclude_tags": [
          "advanced"
        ],
        "reading_level": "simple"
      },
      "13-17": {
        "exclude_tags": [],
        "reading_level": "youth"
      },
      "18-99": {
        "exclude_tags": [],
        "reading_level": "standard"
      }
    },
    "experience": {
      "beginner": {
        "include_tags": [
          "beginner_safe"
        ],
        "exclude_tags": [
          "advanced"
        ]
      },
      "intermediate": {
        "include_tags": [
          "intermediate_safe"
        ],
        "exclude_tags": []
      },
      "advanced": {
        "include_tags": [
          "advanced"
        ]
      }
    }
  },
  "lpi_generation": {
    "chapters": 10,
    "lessons_per_chapter": 4,
    "quiz_mode": "choice_abcd",
    "scoring": {
      "pass_threshold": 0.7
    },
    "tempo_policy": "match_profile_tempo"
  },
  "locale": {
    "default": "en-US",
    "fallbacks": [
      "en"
    ]
  },
  "id_format": {
    "user_id": "WB-<ENV>-<SEQ>-<YYYYMMDDHHmm>",
    "env_values": [
      "POC",
      "BETA",
      "LIVE"
    ]
  }
}